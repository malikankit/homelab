# ═══════════════════════════════════════════════════════
# Auto-attach tmux on SSH login
# ═══════════════════════════════════════════════════════
# Only fires for an incoming SSH session (not geekom's own desktop
# terminal) that isn't already inside tmux. `exec` replaces this shell
# with the tmux client so there's no leftover outer shell process.
# Every SSH connection shares one session ("main"): if it already
# exists, this opens a fresh *window* in it instead of dropping you
# into whatever window/pane another connection is looking at (tmux
# lets each attached client point at a different window of the same
# session, so this doesn't collide); if "main" doesn't exist yet, it's
# created fresh (with just its one default window — no extra blank
# window tacked on). To see all windows: prefix+w. To rejoin from
# elsewhere: `tmux attach -t main` then prefix+<window number>.
if [[ -n "$SSH_CONNECTION" ]] && [[ -z "$TMUX" ]]; then
  if tmux has-session -t main 2>/dev/null; then
    exec tmux new-window -t main \; attach-session -t main
  else
    exec tmux new-session -s main
  fi
fi

# ═══════════════════════════════════════════════════════
# Oh My Zsh
# ═══════════════════════════════════════════════════════
export ZSH="$HOME/.oh-my-zsh"

# Powerlevel10k disabled in favor of a plain bash-style prompt (see below) —
# no icons/Nerd Font/terminal-escape-sequence support needed, works
# identically in every terminal. Set back to "powerlevel10k/powerlevel10k"
# any time to re-enable it (also uncomment the instant-prompt block above
# and the source line in the Prompt section below).
ZSH_THEME=""

plugins=(
  git
  z
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting   # must stay last in this list
  zsh-completions
)

source $ZSH/oh-my-zsh.sh

# ═══════════════════════════════════════════════════════
# Prompt — plain bash-style: user@host:path$
# ═══════════════════════════════════════════════════════
# Powerlevel10k is still installed (~/.p10k.zsh) but disabled above in
# favor of this. Re-enable by setting ZSH_THEME back above and
# uncommenting the line below (plus the instant-prompt block at the top).
# [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
PROMPT='%n@%m:%~$ '

# ═══════════════════════════════════════════════════════
# fzf (Ctrl+R history search, Ctrl+T file find, Alt+C cd)
# ═══════════════════════════════════════════════════════
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# ═══════════════════════════════════════════════════════
# PATH
# ═══════════════════════════════════════════════════════
if [ -d "${HOME}/.local/bin" ] && [[ ":${PATH}:" != *":${HOME}/.local/bin:"* ]]; then
    PATH="${HOME}/.local/bin:${PATH}"
fi

# ═══════════════════════════════════════════════════════
# Remote-session background color — visual "you're on geekom" flag
# ═══════════════════════════════════════════════════════
# Only fires when this shell was reached via SSH (not a local login), so
# it doesn't recolor geekom's own desktop terminal — only a terminal
# that's SSH'd in from elsewhere. Uses OSC 11 (set background color),
# supported by iTerm2, kitty, alacritty, wezterm, foot, etc. macOS
# Terminal.app doesn't support it — this is a harmless no-op there, not
# an error. Restores the terminal's own background on shell exit (OSC 111).
if [[ -n "$SSH_CONNECTION" ]]; then
  printf '\033]11;#fdf6e3\007'
  trap 'printf "\033]111\007"' EXIT
fi

# ═══════════════════════════════════════════════════════
# Aliases — shared ones live in the homelab repo, one copy for every
# machine (see dotfiles/README.md for the convention).
# ═══════════════════════════════════════════════════════
[ -f ~/code/homelab/dotfiles/aliases.sh ] && source ~/code/homelab/dotfiles/aliases.sh

# Machine-specific (not in the shared file). Keyed on the "machine" value
# set in this host's ~/.config/chezmoi/chezmoi.toml [data] section (see
# ../HOMELAB.md for the machine name / Tailscale short-name mapping) —
# not on OS hostname, so this doesn't silently break if a machine is
# renamed at the OS level without the chezmoi config being touched.
{{- $machine := .machine | default "" }}
{{- if eq $machine "geekom-linux" }}
alias sham="ssh -i ~/.ssh/geekom-linux_to_tailnet_ed25519 am@100.105.210.109"
alias sshme="ssh -i ~/.ssh/geekom-linux_to_tailnet_ed25519"
{{- else if eq $machine "mba13-linux" }}
alias sshme="ssh -i ~/.ssh/mba13-linux_to_tailnet_ed25519"
{{- else if eq $machine "mba13-mac" }}
alias hlm="cd ~/code/homelab/mba13/"
alias sshg="ssh -i ~/.ssh/mba13-mac_to_tailnet am@100.78.110.5"       # geekom-linux
alias sshl="ssh -i ~/.ssh/mba13-mac_to_tailnet am@100.105.210.109"    # mba13-linux (other boot, same hardware)
alias sshme="ssh -i ~/.ssh/mba13-mac_to_tailnet"
{{- else if eq $machine "mbp16-mac" }}
alias hlp="cd ~/code/homelab/mbp16/"
alias sshg="ssh -i ~/.ssh/id_rsa am@100.78.110.5"       # geekom-linux
alias sshm="ssh -i ~/.ssh/id_rsa am@100.105.210.109"    # mba13-linux
alias sshme="ssh -i ~/.ssh/id_rsa"
{{- end }}
